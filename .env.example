# Copy to .env for running the API outside docker (npm run start:dev).
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (or set DATABASE_URL=postgres://user:pass@host:5432/db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sitetrack
DB_USER=sitetrack
DB_PASSWORD=sitetrack
DB_POOL_MAX=20
DB_MIGRATE_ON_START=true

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Rate limiting (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_LIMIT=20

# Seeder: 1 = full scale from the brief, 0.05 = small demo set
SEED_SCALE=1
